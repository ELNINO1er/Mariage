{
  "name": "noces",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && node prisma/seed-admin.cjs && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:validate": "prisma validate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:admin": "node prisma/seed-admin.cjs",
    "media:migrate": "node scripts/migrate-media-to-s3.cjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run prisma:validate && npm run test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@prisma/client": "6.19.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "2.4.3",
    "lucide-react": "0.468.0",
    "next": "16.3.3",
    "next-auth": "^5.0.0-beta.32",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.18",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "^22.20.1",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.3.3",
    "prisma": "6.19.0",
    "typescript": "5.7.2",
    "vitest": "^4.1.11"
  }
}
